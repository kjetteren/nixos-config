diff --git a/shell.qml b/shell.qml
index 60cb877..ce4c932 100644
--- a/shell.qml
+++ b/shell.qml
@@ -6,6 +6,8 @@
 
 import QtQuick
 import Quickshell
+import Quickshell.Io
+import Quickshell.Hyprland
 import Caelestia.Config
 import qs.services
 import qs.modules.areapicker
@@ -17,6 +19,16 @@ import qs.daemons
 ShellRoot {
     id: root
 
+    // The wallpaper, bar and border windows are only created once we know the
+    // session isn't locked, or once the lock screen is up. After a crash
+    // Quickshell relaunches the shell behind the still-locked session, and
+    // windows that can't be drawn there would hold up the lock screen.
+    property bool desktopReady: false
+
+    // Cursor position saved when the session locks, restored on unlock
+    property point savedCursor
+    property bool hasSavedCursor: false
+
     settings.watchFiles: true
 
     Component.onCompleted: {
@@ -41,13 +53,110 @@ ShellRoot {
     }
 
     // Modules
-    Background {}
-    Drawers {}
+    LazyLoader {
+        active: root.desktopReady
+
+        Background {}
+    }
+
+    LazyLoader {
+        active: root.desktopReady
+
+        Drawers {}
+    }
+
     AreaPicker {}
     Lock {
         id: lock
     }
 
+    // Take the lock back if Hyprland still holds it (the shell crashed while
+    // locked). Needs misc:allow_session_lock_restore.
+    Process {
+        running: true
+        command: ["hyprctl", "locked"]
+        stdout: StdioCollector {
+            onStreamFinished: {
+                if (text.trim() === "true")
+                    lock.lock.locked = true;
+                else
+                    root.desktopReady = true;
+            }
+        }
+    }
+
+    Connections {
+        function onSecureStateChanged(): void {
+            if (lock.lock.secure)
+                root.desktopReady = true;
+        }
+
+        function onLockStateChanged(): void {
+            if (lock.lock.locked) {
+                root.hasSavedCursor = false;
+                saveCursor.running = true;
+            } else {
+                root.desktopReady = true;
+                if (root.hasSavedCursor)
+                    restoreCursor.running = true;
+            }
+        }
+
+        target: lock.lock
+    }
+
+    // Hyprland warps the cursor when HDMI-A-1 drops out at resume, so put it
+    // back where it was when the session locked.
+    Process {
+        id: saveCursor
+
+        command: ["hyprctl", "cursorpos"]
+        stdout: StdioCollector {
+            onStreamFinished: {
+                const m = text.match(/(-?\d+),\s*(-?\d+)/);
+                if (m) {
+                    root.savedCursor = Qt.point(parseInt(m[1]), parseInt(m[2]));
+                    root.hasSavedCursor = true;
+                }
+            }
+        }
+    }
+
+    Process {
+        id: restoreCursor
+
+        command: ["hyprctl", "dispatch", `hl.dsp.cursor.move({ x = ${root.savedCursor.x}, y = ${root.savedCursor.y} })`]
+    }
+
+    // The warp happens while the lock screen is up, so also restore whenever a
+    // monitor comes or goes while locked. Debounced so it runs after Hyprland
+    // has finished moving the cursor itself.
+    Timer {
+        id: restoreCursorLater
+
+        interval: 150
+        onTriggered: {
+            if (lock.lock.locked && root.hasSavedCursor)
+                restoreCursor.running = true;
+        }
+    }
+
+    Connections {
+        function onRawEvent(event: HyprlandEvent): void {
+            if (event.name === "monitorremoved" || event.name === "monitoradded")
+                restoreCursorLater.restart();
+        }
+
+        target: Hyprland
+    }
+
+    // Never leave the desktop without its windows if the checks above fail
+    Timer {
+        running: !root.desktopReady
+        interval: 3000
+        onTriggered: root.desktopReady = true
+    }
+
     // Daemons
     Shortcuts {}
     BatteryMonitor {}
